# Copy to .env and replace every example secret before exposing the service.
PORT=8787
CONTROL_SHARED_SECRET=replace-with-64-hex-characters
LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_WS_URL=wss://voice.example.com
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-with-a-long-random-livekit-secret
VOICE_RADIUS_BLOCKS=28
CODE_TTL_SECONDS=120
SESSION_TTL_SECONDS=7200
MAX_PLAYERS_PER_SERVER=200
